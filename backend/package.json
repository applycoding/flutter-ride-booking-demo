{
  "name": "quay-rides-api",
  "version": "0.1.0",
  "private": true,
  "description": "Local Cloudflare Workers API for the Quay ride-booking demo.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "migrate:local": "wrangler d1 migrations apply quay-rides --local",
    "test": "vitest run",
    "typecheck": "wrangler types && tsc --noEmit && tsc -p test --noEmit",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^4.20251011.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.42.0"
  }
}
